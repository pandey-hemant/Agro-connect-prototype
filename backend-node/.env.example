# Server
PORT=5050

# MongoDB — if blank, the server boots mongodb-memory-server automatically
MONGODB_URI=mongodb://127.0.0.1:27017/agroconnect

# Market prices
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_PRICE_DEMO_FALLBACK=true
MARKET_PRICE_TIMEOUT_SECONDS=8
# Phase 3 — CSV import path. Leave empty to disable. Backend-Node
# falls back to the demo dataset if the file is missing or unreadable.
MARKET_PRICE_CSV_PATH=data/market_prices.csv

# Maps / routing (optional, leave empty for haversine estimate)
MAPS_API_KEY=
ROUTING_API_KEY=
ROUTING_URL=https://router.project-osrm.org/route/v1/driving/
# Phase 3 — Geoapify routing alternative. Used only when
# ROUTING_API_KEY is empty. NEVER expose this in any HTTP response.
# The value is just the API key (not the full URL). Leave empty to
# fall back to straight-line (haversine) distance.
GEOAPIFY_API_KEY=40439e65662e4c39acb83d3ba7cc7de4

# Logistics defaults
LOGISTICS_TRANSPORT_RATE_PER_KM_PER_KG=0.0015
LOGISTICS_MIN_TRANSPORT=300
LOGISTICS_LOADING_PER_KG=0.05
LOGISTICS_UNLOADING_PER_KG=0.05
LOGISTICS_OTHER_CHARGES_PCT=0.02
LOGISTICS_AVG_SPEED_KMPH=40
# Phase 3 — default vehicle class. One of 32FT_MXL, 32FT_SXL, 24FT,
# 22FT, 20FT, 19FT_OPEN. Vehicle rate is from the frozen table in
# config/index.js; the operator can override per call via the
# `vehicle_type` field on /api/logistics/estimate.
LOGISTICS_DEFAULT_VEHICLE=20FT
# Phase 3 — kg-per-vehicle floor for the num_vehicles math.
LOGISTICS_VEHICLE_CAPACITY_KG=5000
# Phase 3 — mandi cess / weighing / commission per kg.
OTHER_COSTS_PER_KG=0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Demo seed (run on first boot if DB is empty)
RUN_SEED_ON_STARTUP=true

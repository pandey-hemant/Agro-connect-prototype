# Copy to .env and adjust as needed.

# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy URL. Defaults to a local SQLite file for dev.
# Example for Postgres in production:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agroconnect
DATABASE_URL=sqlite:///./agroconnect.db

# ---- Phase 3: Market Price provider ----
# Which provider to use for mandi price data. One of:
#   data_gov_in — live AGMARKNET data via api.data.gov.in (needs API key)
#   demo        — built-in seed data, clearly labelled as demo
# Defaults to "data_gov_in" so production behaviour is the live one.
MARKET_PRICE_PROVIDER=data_gov_in

# Free API key from https://www.data.gov.in/. The key stays on the server
# and is NEVER sent to the frontend. Leave empty to force demo data.
DATA_GOV_IN_API_KEY=

# Resource UUID for "Current Daily Price of Various Commodities from
# Various Markets (Mandi)" on data.gov.in.
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# If the live provider errors, automatically fall back to demo data so
# the UI is never empty. Set to false to surface the error as a 503.
MARKET_PRICE_DEMO_FALLBACK=true

# Network timeout (seconds) for live provider HTTP calls.
MARKET_PRICE_TIMEOUT_SECONDS=8

# ---- Phase 4: Logistics estimates ----
# All values are estimates, never live. Defaults are safe and used when
# the env var is not set.
LOGISTICS_TRANSPORT_RATE_PER_KM_PER_KG=0.0015
LOGISTICS_MIN_TRANSPORT=300
LOGISTICS_LOADING_PER_KG=0.05
LOGISTICS_UNLOADING_PER_KG=0.05
LOGISTICS_OTHER_CHARGES_PCT=0.02
LOGISTICS_AVG_SPEED_KMPH=40
LOGISTICS_DEFAULT_VEHICLE=mini-truck

# Optional live routing — leave empty to use the haversine estimate.
# The key never leaves the backend.
MAPS_API_KEY=
ROUTING_API_KEY=
# Public OSRM demo by default; switch to a paid provider in production.
ROUTING_URL=https://router.project-osrm.org/route/v1/driving/
